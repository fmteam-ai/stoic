{$DOMAIN} www.{$DOMAIN} {
	encode gzip
	# daily report S5 — the edge guarantees the headers even when a cached/old frontend image lacks them
	# (`?` = set only if the upstream response did not already carry the header; CSP mirrors deploy/nginx.conf)
	header {
		?Strict-Transport-Security "max-age=31536000; includeSubDomains"
		?Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' wss: https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'"
		?X-Frame-Options "DENY"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
	}
	reverse_proxy frontend:3000
}
