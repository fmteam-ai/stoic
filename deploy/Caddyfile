{$DOMAIN} www.{$DOMAIN} {
	encode gzip
	# Forward the Caddy-resolved client IP as a single hop (client-supplied
	# X-Forwarded-For from untrusted peers is discarded). deploy/nginx.conf
	# trusts this hop (set_real_ip_from docker ranges) and the backend keys
	# rate limits on the rightmost X-Forwarded-For entry (SEC-002).
	reverse_proxy frontend:3000 {
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
	}
}
