# Compose-level config — copy to ./.env (repo root). deploy/install.sh
# fills this automatically. NON-SECRET values only: passwords/keys live in
# Docker secrets under ./secrets/ (also generated by install.sh).
MONGO_ROOT_USER=
MONGO_APP_USER=
DB_NAME=
REACT_APP_BACKEND_URL=
# Signing/hash keys are Docker secrets generated ONCE by deploy/install.sh (ensure_release_secrets):
#   secrets/ledger_anchor_key, secrets/bridge_token_hash_key (never change — changing it un-pairs every EA),
#   secrets/order_auth_secret. Leave these empty here unless you run without Docker secrets.
LEDGER_ANCHOR_KEY=
BRIDGE_TOKEN_HASH_KEY=
# crypto master switches — leave BOTH unset/false through the whole demo
CRYPTO_LIVE_TRADING_ENABLED=
BINANCE_LIVE_ENABLED=
# Disaster recovery (optional): encrypted + off-site backups — see docs/DISASTER_RECOVERY.md
BACKUP_PASSPHRASE_FILE=
BACKUP_RCLONE_REMOTE=
BACKUP_S3_URI=
BACKUP_OFFSITE=
# build (default) | registry — pull CI-built GHCR images by attested digest
DEPLOY_MODE=
# N101-5 — key id the signer sidecar answers for (install.sh: stoic-bundle-ed25519-v1 = runtime key)
SIGNER_KEY_ID=
# 1 = let deploy scripts repair Docker overlay2 "device or resource busy" zombies
# during recreate (detach leaked mount copies, remove dead containers; every
# mutation journaled in deploy/releases/docker-repair-journal.jsonl). Default
# is diagnosis-only. Set on hosts where deploy/doctor.sh reports mount propagation leaks.
STOIC_REPAIR_DOCKER_MOUNTS=
# topology policy gate for deploys: accounts/enabled/bots (e.g. 6/3/3).
# MANDATORY when APP_ENV=production (must equal RECONCILE_APPROVED_POLICY, default 6/3/3)
RECONCILE_EXPECT=
RECONCILE_APPROVED_POLICY=
# production tenant/portfolio owner user id — reconciliation scope (mandatory in production)
RECONCILE_SCOPE_USER_ID=
# per-region prober cadence in seconds, e.g. gha=300 (regions not listed sample every 60 s)
EDGE_PROBE_CADENCE=
