# STOIC backend environment — copy to backend/.env and fill in.
# No defaults are assumed: missing required values fail fast at startup.

# MongoDB connection string. In docker-compose this is injected by the
# compose file itself (authenticated least-privilege app user, e.g.
# mongodb://app_user:pass@mongo:27017/dbname?authSource=dbname)
MONGO_URL=
# MongoDB database name
DB_NAME=
# comma-separated allowed origins
CORS_ORIGINS=
# FRED macro data
FRED_API_KEY=
# long random secret for session tokens — REQUIRED
JWT_SECRET=
ORDER_AUTH_SECRET=
LEDGER_ANCHOR_KEY=
# set to "production" in the PROD deploy env to activate guardrails
# (refuses the weak default admin + forbids the *_BYPASS_TOKENs). Leave blank in preview.
APP_ENV=
# seed admin login (default: admin@stoicaibot.com)
ADMIN_EMAIL=
# seed admin password (min 8 chars; production REQUIRES >=12 and refuses "admin123")
ADMIN_PASSWORD=
# Force the admin password reset on next seed run (lockout recovery)
ADMIN_PASSWORD_FORCE_RESET=
# Emergent universal LLM key (AI agents / Risk Commander)
EMERGENT_LLM_KEY=
# fix plan A2 — hard timeout for every AI call made from the trading loop (seconds, default 10, floor 2)
AI_CALL_TIMEOUT_SEC=
# roadmap step 7 — model selection lives in backend/llm_models.py (tiers fast / analysis / deep /
# ai_optimizer / ai_optimizer_fallback). Override a tier here; blank = built-in default.
LLM_MODEL_FAST=
LLM_MODEL_ANALYSIS=
LLM_MODEL_DEEP=
LLM_MODEL_AI_OPTIMIZER=
LLM_MODEL_AI_OPTIMIZER_FALLBACK=
# Alpha Vantage market data
ALPHA_VANTAGE_KEY=
# NewsAPI headlines
NEWSAPI_KEY=
# Finnhub market data
FINNHUB_KEY=
# main bot loop cadence (seconds)
BOT_LOOP_INTERVAL_SEC=
# per-symbol signal cooldown (minutes)
BOT_SIGNAL_COOLDOWN_MIN=
# trading freeze before red-news (minutes)
MACRO_FREEZE_BEFORE_MIN=
# trading freeze after red-news (minutes)
MACRO_FREEZE_AFTER_MIN=
# Stripe secret key (billing)
STRIPE_API_KEY=
# true/false — allow live crypto orders
BINANCE_LIVE_ENABLED=
# A13-1 — operator kill switch for ALL live crypto orders (default off; BOTH flags must be true)
CRYPTO_LIVE_TRADING_ENABLED=
# A13-2 — REQUIRED in production: bridge tokens are HMAC-hashed under this key (32+ random chars, != JWT_SECRET).
# Set it ONCE before the first boot of this release and never change it (production refuses to boot without it).
BRIDGE_TOKEN_HASH_KEY=
# A13 P1-01 — require a signed operational acceptance bundle before live authority (always on in production)
ACCEPTANCE_BUNDLE_REQUIRED=
# crypto per-trade risk cap (percent)
CRYPTO_MAX_RISK_PCT_PER_TRADE=
# Resend transactional email
RESEND_API_KEY=
# fix plan S8 — REQUIRED in production: the server refuses to start without it (activation/reset links only travel by email)
# fix plan S1 — passkeys: pin both in production (server refuses passkey ceremonies otherwise), e.g. stoicaibot.com / https://stoicaibot.com
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
# verified sender address for Resend
SENDER_EMAIL=
# display name used in the email From header (optional)
SENDER_NAME=
# inbox notified when a new support ticket is opened (optional)
SUPPORT_NOTIFY_EMAIL=
# require TOTP MFA for all admin accounts (default true)
ADMIN_MFA_ENFORCED=
# base64 raw 32-byte Ed25519 private key for release-manifest signing
ED25519_SIGNING_KEY_B64=
# Cloudflare Turnstile widget keys (dashboard → Turnstile → Add site)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# set true ONLY when the origin is reachable exclusively via Cloudflare (R-8: behind Cloudflare
# EVERY user otherwise shares the Cloudflare edge IP — rate limits / SA4 blocks hit all of them)
TRUST_CF_CONNECTING_IP=
# N-R1 — internal reverse-proxy hops (Caddy/nginx docker ranges) skipped when reading X-Forwarded-For
# (install.sh sets the docker defaults; leave blank behind a single ingress that appends the client IP)
# REQUIRED behind 2+ proxy hops (Cloudflare → Caddy → nginx): otherwise every client collapses to the
# edge IP and per-IP rate limits / SA4 IP blocks degrade to one shared bucket. Production logs a boot warning when unset.
TRUSTED_PROXY_CIDRS=
# revoke refresh sessions idle longer than this many minutes (0 disables)
SESSION_IDLE_TIMEOUT_MINUTES=
# inventory go-live approvals: four_eyes (default — a DIFFERENT admin approves/confirms) or
# single_admin (explicit operator choice for one-person operations: the proposing admin approves
# after a fresh step-up; every approval event is stamped approval_mode=single_admin)
INVENTORY_APPROVAL_MODE=
# concurrent-refresh grace: a just-consumed refresh token re-presented within this many
# seconds (second tab / parallel 401s) continues the chain instead of revoking the family
# and logging the user out everywhere (default 60; 0 = strict reuse detection)
REFRESH_REUSE_GRACE_SECONDS=
# roadmap step 3 (C3): heartbeat reconciliation closes a DB-open trade only after its ticket
# is missing from this many CONSECUTIVE heartbeats (default 2) and for at least this many
# seconds (default 10) — a single glitchy snapshot can no longer ghost-close a live position
RECONCILE_MISS_CONFIRMATIONS=
RECONCILE_MISS_MIN_SECONDS=
# roadmap step 3 (C4) / fix plan A2+A3 (B3, R4): a NEW pending market order expires after this
# many seconds (status=cancelled, close_reason=expired) instead of filling hours later after a
# reconnect — counted from creation when never sent, from the hand-over when the terminal picked
# it up (default 120, floor 30). A fill reported afterwards still lands. Close requests never expire.
PENDING_ORDER_TTL_SECONDS=
# comma-separated IPs exempt from rate limits
RATE_LIMIT_EXEMPT_IPS=
# header token for CI/testing rate-limit bypass — refused when APP_ENV=production
RATE_LIMIT_BYPASS_TOKEN=
# header token for CI/testing step-up MFA bypass — refused when APP_ENV=production (startup hard-fails if set)
STEP_UP_BYPASS_TOKEN=
# master key encrypting stored broker/exchange secrets
KEY_VAULT_MASTER=
# true/false — run workers inside the API process
BACKGROUND_WORKERS_IN_PROCESS=
# token for GET /api/metrics (Prometheus scrape auth)
METRICS_TOKEN=
# true only for non-production websocket testing
WS_ALLOW_QUERY_TOKEN=
# comma-separated origins allowed to open Stripe checkout sessions
CHECKOUT_ALLOWED_ORIGINS=
# REQUIRED — HMAC key signing the VPS artifact manifest (server refuses to start unsigned delivery without it)
AGENT_SIGNING_KEY=
# Deployment kill-switches for heavy ML inference on memory-constrained pods (default true)
FORECAST_AGENT_ENABLED=
ML_ENSEMBLE_ENABLED=
# Auto-rollback bake window + thresholds (deployment_health.py)
DEPLOY_BAKE_HOURS=
DEPLOY_MIN_HEALTH=
DEPLOY_MAX_HEALTH_DROP=
# Distinct TRUSTED tenants that must corroborate a deploy failure before auto-rollback/promotion-hold
DEPLOY_MIN_FAIL_TENANTS=
# Comma-separated operator tenant user_ids whose agents' telemetry is authoritative for auto-rollback
RELEASE_TRUST_USER_IDS=
# Max active (non-revoked) host agents per tenant account
VPS_MAX_AGENTS_PER_USER=
# Enforce Origin/Referer checks on state-changing requests (true/false)
CSRF_ENFORCE_ORIGIN=
# Release signing (round 9 P1-01): production REQUIRES external with ALL of the following and NO ED25519_SIGNING_KEY_B64
RELEASE_SIGNER=
RELEASE_SIGNER_URL=
RELEASE_SIGNER_ALLOWED_HOSTS=
RELEASE_SIGNER_TOKEN=
RELEASE_SIGNER_KEY_ID=
RELEASE_PUBLIC_KEY_B64=
# v1.60.7 — PUBLIC signer the installer/update preflight fetches the CI release key from (GET /public-key);
# key_id must equal RELEASE_SIGNER_KEY_ID; the local sidecar key is never pinned. Default https://stoic-signer.fly.dev
RELEASE_SIGNER_PUBLIC_URL=
RELEASE_SIGNER_TIMEOUT=
# N101-5 — runtime (bundle) signing: the API holds ONLY this token (compose: secrets/signer_token_bundle);
# RELEASE_SIGNER_TOKEN is the CI release token and must NOT live on the API host (update.sh strips it).
RELEASE_SIGNER_BUNDLE_TOKEN=
# Runtime (sidecar) key pinned separately from the CI release key — unset = single-key install
BUNDLE_SIGNER_KEY_ID=
BUNDLE_PUBLIC_KEY_B64=
# Redis for the distributed Enterprise-API rate limiter (empty = Mongo fallback)
REDIS_URL=
STATEMENT_ATTESTATION_PUBLIC_KEY_B64=
DEPLOY_WATCH_ALLOWED_HOSTS=
DEPLOY_WATCH_INTERVAL_SEC=
NL_EFFECTS_SYNTHETIC_ONLY=
EA_RELEASE_SHA256=
BRIDGE_IP_LIMIT_PER_MIN=
MAX_REQUEST_BODY_BYTES=
PRODUCTION_RETIRED_SECRETS=
RELEASE_SIGNER_DEFERRED=
TURNSTILE_EXPECTED_HOSTNAMES=
# Security & Health Agent — observe mode by default; SA4 enforce: SECURITY_AGENT_MODE=enforce + SECURITY_AGENT_RULES=R1,R4 (one at a time)
# SECURITY_AGENT_MODE: blank = default observe
SECURITY_AGENT_MODE=
SECURITY_AGENT_RULES=
SECURITY_AGENT_PROTECTED_IPS=
# SA5 S3 — R5 token suspension lifetime (minutes; re-pairing lifts it earlier)
# SECURITY_AGENT_TOKEN_SUSPEND_MIN: blank = default 240
SECURITY_AGENT_TOKEN_SUSPEND_MIN=
# SA5 S14 — production: the Telegram token is a Docker secret on worker-security only
# (docker-compose sets SECURITY_AGENT_TELEGRAM_BOT_TOKEN_FILE=/run/secrets/security_telegram_token); never put it here
# A7d — execution-health brake: anomalies (late fill / reject / slippage veto / duplicate ticket) per account
# EXEC_BRAKE_THRESHOLD: blank = default 3
EXEC_BRAKE_THRESHOLD=
# EXEC_BRAKE_WINDOW_MIN: blank = default 120
EXEC_BRAKE_WINDOW_MIN=
# EXEC_BRAKE_RELEASE_MIN: blank = default 60
EXEC_BRAKE_RELEASE_MIN=
# SECURITY_AGENT_MAX_ACTIONS_PER_HOUR: blank = default 10
SECURITY_AGENT_MAX_ACTIONS_PER_HOUR=
# SECURITY_AGENT_IP_BLOCK_MIN: blank = default 60
SECURITY_AGENT_IP_BLOCK_MIN=
# SECURITY_AGENT_ACCOUNT_LOCK_MIN: blank = default 30
SECURITY_AGENT_ACCOUNT_LOCK_MIN=
# SECURITY_AGENT_CRITICAL_REPEAT_MIN: blank = default 30
SECURITY_AGENT_CRITICAL_REPEAT_MIN=
# SECURITY_AGENT_DAILY_REPORT_UTC: blank = default 07:00
SECURITY_AGENT_DAILY_REPORT_UTC=
# SECURITY_AGENT_RETENTION_DAYS: blank = default 180
SECURITY_AGENT_RETENTION_DAYS=
# SECURITY_AGENT_AI_SUMMARY: blank = default off
SECURITY_AGENT_AI_SUMMARY=
SECURITY_AGENT_ALERT_EMAILS=
# SA3 — dedicated security Telegram chat (separate bot from trade alerts). Docker secrets on the host;
# unset = alerts are logged + emailed only (fail-open, never blocks the agent)
SECURITY_AGENT_TELEGRAM_BOT_TOKEN=
SECURITY_AGENT_TELEGRAM_CHAT_ID=
# Host migration (admin → Host Migration): isolated migrator service on the new host; token via Docker secret (_FILE)
MIGRATOR_URL=
MIGRATOR_TOKEN=
# Test-only toggles — NEVER set in production. Mutating HTTP suites need STOIC_ALLOW_MUTATING_TESTS=YES;
# the HTTP suites read the admin login from TEST_ADMIN_EMAIL / TEST_ADMIN_PASSWORD (per-run CI secrets).
STOIC_ALLOW_MUTATING_TESTS=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
# v1.60.7 — host profile recorded by deploy/preflight.sh (shared-web-host|dedicated): a cPanel/Plesk/DirectAdmin or
# httpd/exim/dovecot host BLOCKS live trading in production (warning in demo-only). Never set by hand.
STOIC_HOST_PROFILE=
STOIC_HOST_MARKERS=
