# STOIC frontend — reproducible build (Vite build served by nginx)
# Base images are tag-pinned; scripts/pin_image_digests.sh rewrites them to
# tag@sha256 (needs registry access) — CI reports unpinned images.
FROM node:22-alpine AS build

WORKDIR /app/frontend
COPY frontend/package.json frontend/yarn.lock ./
RUN yarn install --frozen-lockfile

COPY frontend/ ./
ARG REACT_APP_BACKEND_URL
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL
RUN yarn build

FROM nginx:1.29-alpine
# Patch OS packages (libssl/libcrypto fixes) and drop curl — nginx doesn't
# need it and its unfixed alpine CVEs would fail the image vulnerability gate.
RUN apk upgrade --no-cache && apk del --no-cache curl || true
COPY --from=build /app/frontend/build /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 3000
