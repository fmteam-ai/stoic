# STOIC backend — reproducible build (FastAPI + workers)
FROM python:3.11-slim

WORKDIR /app/backend

# OS security patches only — no curl (its recurring CVEs would trip the
# image vulnerability gate; the healthcheck uses python's stdlib instead).
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
    # emergentintegrations pins openai==1.99.9 but litellm>=1.84 (security
    # fix GHSA-4xpc/GHSA-jjhc) needs openai>=2.x — all its deps are pinned
    # in requirements.txt, so install it without dependency resolution.
    && pip install --no-cache-dir --no-deps emergentintegrations==0.2.0 \
       --extra-index-url https://d33sy5i8bnduwe.cloudfront.net/simple/

COPY backend/ ./

# Run unprivileged (security-audit hardening)
RUN useradd --create-home --shell /usr/sbin/nologin stoic \
    && chown -R stoic:stoic /app/backend
USER stoic

EXPOSE 8001
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request,sys; r=urllib.request.urlopen('http://localhost:8001/api/health', timeout=4); sys.exit(0 if r.status==200 else 1)" || exit 1

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8001"]
