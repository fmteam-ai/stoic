# STOIC backend — reproducible build (FastAPI + workers)
FROM python:3.11-slim

WORKDIR /app/backend

# OS security patches only — no curl (its recurring CVEs would trip the
# image vulnerability gate; the healthcheck uses python's stdlib instead).
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt ./requirements.txt
# emergentintegrations lives ONLY on the Emergent CDN index and pins
# openai==1.99.9 while litellm>=1.84 (security fix GHSA-4xpc/GHSA-jjhc)
# needs openai>=2.x — filter it from the freeze, install everything
# else from PyPI, then install it from the CDN index EXCLUSIVELY
# (dependency-confusion hardening) with a sha256-pinned wheel and a
# retry (the CDN index intermittently serves an empty page).
ARG EI_SHA256=1822c409e24817689541891784b8ec3ff4dfed845ce8cd09fd4feb91ba3a4bdd
RUN grep -v '^emergentintegrations' requirements.txt > /tmp/reqs.txt \
    && pip install --no-cache-dir -r /tmp/reqs.txt \
    && for i in 1 2 3 4 5; do \
         pip download --no-deps emergentintegrations==0.2.0 -d /tmp/ei \
           --index-url https://d33sy5i8bnduwe.cloudfront.net/simple/ \
           && break; \
         echo "emergentintegrations attempt $i failed — retry in 15s"; \
         sleep 15; \
       done \
    && echo "${EI_SHA256}  /tmp/ei/emergentintegrations-0.2.0-py3-none-any.whl" | sha256sum -c - \
    && pip install --no-cache-dir --no-deps /tmp/ei/emergentintegrations-0.2.0-py3-none-any.whl \
    && pip show -q emergentintegrations \
    && rm -rf /tmp/ei /tmp/reqs.txt

COPY backend/ ./

# Immutable build provenance — the image knows EXACTLY which commit built it.
# Production builds FAIL without a valid 40-hex Git SHA.
ARG GIT_SHA
RUN echo "${GIT_SHA}" | grep -qE '^[0-9a-f]{40}$' \
    || { echo "BUILD BLOCKED: GIT_SHA build-arg (40-hex commit) is required"; exit 1; } \
    && echo "${GIT_SHA}" > BUILD_SHA

# Run unprivileged (security-audit hardening)
RUN useradd --create-home --shell /usr/sbin/nologin stoic \
    && chown -R stoic:stoic /app/backend
USER stoic

EXPOSE 8001
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request,sys; r=urllib.request.urlopen('http://localhost:8001/api/health', timeout=4); sys.exit(0 if r.status==200 else 1)" || exit 1

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8001", "--timeout-keep-alive", "650"]
